local S = { started = false, mode = nil, status = "off" }

local function selectTab(index)
	activeTab = index
	for i, btn in ipairs(tabButtons) do
		local isActive = (i == index)
		btn.BackgroundColor3 = isActive and Settings.Theme.TabBtnActive or Settings.Theme.TabBtnInactive
		btn.BackgroundTransparency = isActive and 0.2 or 0.6
		btn.TextColor3 = isActive and Settings.Theme.TabTextActive or Settings.Theme.TabTextInactive
	end
	for i, content in ipairs(tabContents) do
		content.Visible = (i == index)
	end
	if tabs[index].Mode ~= "ThemeMode" then
		Settings.CtrMode = tabs[index].Mode
		S.started = false
	end
end

for i, t in ipairs(tabs) do
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(1 / #tabs, 0, 1, 0)
	btn.BackgroundColor3 = Settings.Theme.TabBtnInactive
	btn.BackgroundTransparency = 0.6
	btn.BorderSizePixel = 0
