	b.BackgroundColor3 = Settings.Theme.SideBtnBg
	b.BackgroundTransparency = 0
	b.BorderSizePixel = 0
	b.Text = ""
	b.AutoButtonColor = false
	b.Parent = sideHolder

	local s = Instance.new("UIStroke")
	s.Color = Settings.Theme.SideStroke
	s.Transparency = 0
	s.Thickness = 1
	s.Parent = b

	local tx = Instance.new("TextLabel")
	tx.Size = UDim2.fromScale(1, 1)
	tx.BackgroundTransparency = 1
	tx.Text = label
	tx.TextSize = 11
	tx.Font = Enum.Font.GothamMedium
	tx.TextColor3 = Settings.Theme.SideText
	tx.TextXAlignment = Enum.TextXAlignment.Center
	tx.TextYAlignment = Enum.TextYAlignment.Center
	tx.Parent = b

	local btnData = { Button = b, Stroke = s, Label = tx, BaseOrder = order }
	table.insert(sideButtons, btnData)

	b.MouseEnter:Connect(function()
		TweenService:Create(b, TweenInfo.new(0.12), { BackgroundColor3 = Settings.Theme.SideBtnHover }):Play()
	end)
	b.MouseButton1Click:Connect(onClick)
	return b, tx, s
end

