----------------------------------------------------------------------
-- 1. Background Snow Effect
----------------------------------------------------------------------
local snowGui = Instance.new("ScreenGui")
snowGui.Name = "ArtigoSnow"
snowGui.IgnoreGuiInset = true
snowGui.DisplayOrder = 999
snowGui.Enabled = Settings.SnowEnabled
snowGui.Parent = playerGui

local snowParticles = {}
for i = 1, 150 do
	local p = Instance.new("Frame")
	local size = math.random(3, 8)
	p.Size = UDim2.fromOffset(size, size)
	p.BackgroundColor3 = Settings.Theme.SnowColor
	p.BackgroundTransparency = math.random(10, 50) / 100
	p.BorderSizePixel = 0
	p.Position = UDim2.new(math.random(), 0, math.random(), 0)
	p.Active = false
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(1, 0)
	c.Parent = p
	p.Parent = snowGui
	
	table.insert(snowParticles, {
		Frame = p,
		SpeedX = math.random(-150, 150) / 1000,
		SpeedY = math.random(100, 200) / 1000 -- Base speed
	})
end

RunService.RenderStepped:Connect(function(dt)
	if not Settings.SnowEnabled then return end
	for _, p in ipairs(snowParticles) do
		local f = p.Frame
		f.Position = f.Position + UDim2.new(p.SpeedX * dt, 0, p.SpeedY * dt * Settings.SnowSpeed, 0)
		if f.Position.Y.Scale > 1 then
			f.Position = UDim2.new(math.random(), 0, -0.05, 0)
		end
	end
end)

